# Database Credentials & Port
DB_USER=dentapex_admin
DB_PASSWORD=your_secure_password
DB_NAME=dentapex_db
DB_PORT=5432
DATABASE_URL=postgresql+asyncpg://dentapex_admin:your_secure_password@127.0.0.1:5432/dentapex_db

# Security
SECRET_KEY=your_secret_key_32chars_minimum_here
ACCESS_TOKEN_EXPIRE_MINUTES=43200
REFRESH_TOKEN_EXPIRE_DAYS=30
ALGORITHM=HS256
BUDGET_PUBLIC_SECRET_KEY=your_budget_secret_key_here

# Environment
ENVIRONMENT=production
DEMO_MODE=False
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Module System
DENTAPEX_DEV_MODULE_SCAN=True
DENTAPEX_FRONTEND_ROOT=../frontend
DENTAPEX_MODULE_PKG_ROOT=app/modules

# AI & LLM Settings
LLM_PROVIDER=ollama
COPILOT_PROVIDER_DEFAULT=ollama
COPILOT_MODEL_CHAT_OLLAMA=llama3.2
GEMINI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1

# Timezone
TZ="Africa/Cairo"
